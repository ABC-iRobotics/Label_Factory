# Local NVIDIA RTX 2000 Ada Laptop GPU test profile (8 GiB VRAM).
# It keeps the A100 profile's reconstruction-quality parameters but limits
# concurrency and host caching to values suitable for a workstation.
MATCHING_MODE=sequential
SEQUENTIAL_OVERLAP=15
SFM_THREADS=16
METRIC_SCALE_WORKERS=4
SAM6D_TEMPLATE_WORKERS=1
FRAME_SELECTION_TARGET_OVERLAP=0.70
MVS_GPU_INDICES=0
MVS_THREADS=16
MVS_CACHE_SIZE_GB=16
MVS_SOURCE_IMAGES=15
MVS_WINDOW_RADIUS=4
MVS_WINDOW_STEP=1
MVS_NUM_SAMPLES=10
MVS_NUM_ITERATIONS=3
MAX_IMAGE_SIZE=1600
DENSE_NEIGHBORS=10
STABILITY_SCORE_THRESH=0.85
DET_SCORE_THRESH=0.2
# RTX Ada supports TF32 tensor-core inference. Disable with 0 only when strict
# float32 reproducibility is required.
SAM6D_ALLOW_TF32=1
TORCH_CUDA_ARCH_LIST=8.9+PTX
