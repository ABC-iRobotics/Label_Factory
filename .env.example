# Absolute path to the Python executable in the separately prepared SAM-6D environment.
SAM6D_PYTHON=/path/to/conda/envs/sam6d/bin/python

# Optional. Supply only while publishing; never commit a real token.
HF_TOKEN=

# Optional Blender 3.3.1 installation used by BlenderProc template rendering.
SAM6D_BLENDER_PATH=/path/to/blender-3.3.1-linux-x64

