# NVIDIA A100 server profile. Keeps full image resolution and uses the larger
# GPU/host memory budget for concurrent PatchMatch workers.
MATCHING_MODE=sequential
SEQUENTIAL_OVERLAP=15
SFM_THREADS=30
METRIC_SCALE_WORKERS=12
SAM6D_TEMPLATE_WORKERS=2
FRAME_SELECTION_TARGET_OVERLAP=0.70
MVS_GPU_INDICES=0,0,0,0
MVS_THREADS=30
MVS_CACHE_SIZE_GB=64
MVS_SOURCE_IMAGES=15
MVS_WINDOW_RADIUS=4
MVS_WINDOW_STEP=1
MVS_NUM_SAMPLES=10
MVS_NUM_ITERATIONS=3
MAX_IMAGE_SIZE=1600
DENSE_NEIGHBORS=10
STABILITY_SCORE_THRESH=0.85
DET_SCORE_THRESH=0.2
SAM6D_ALLOW_TF32=1
TORCH_CUDA_ARCH_LIST=8.0+PTX
